{
  "name": "kaplum-studio",
  "description": "A visual JavaScript Turtle studio where learners explore examples, understand parameters and create their own drawings.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun scripts/prepare-public.js && next dev --port 4173",
    "build": "bun scripts/prepare-public.js && next build",
    "preview": "STATIC_DIR=out bun server.js",
    "test": "playwright test",
    "profile:previews": "bun scripts/profile-previews.js",
    "verify:push": "bun scripts/verify-push.js",
    "push:verified": "bun scripts/push-and-check.js",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@lezer/javascript": "1.5.6",
    "codemirror": "6.0.2",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
